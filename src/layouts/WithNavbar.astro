---
import type { ComponentProps } from 'astro/types';
import BaseLayout from './BaseLayout.astro';
import NavbarLink from '@/components/NavbarLink.astro';

interface Props extends ComponentProps<typeof BaseLayout> {}

const { ...rest } = Astro.props;
---

<BaseLayout {...rest}>
	<nav
		class="nb-navbar"
		aria-label="Main navigation"
		x-data="{ open: false }"
	>
		<a href="/" class="nb-navbar-brand">
			IcyTv
		</a>
		<button
			class="nb-navbar-toggle"
			type="button"
			aria-label="Toggle navigation"
			aria-controls="navbar-collapse"
			aria-expanded="false"
			x-bind:aria-expanded="open"
			x-on:click="open = !open"
		>
			<span
				aria-hidden="true"
				class="icon-[withicons-brutal--align-justify] size-6"
			></span>
		</button>
		<div
			class="nb-navbar-collapse"
			id="navbar-collapse"
			x-bind:class="{ 'is-open': open }"
		>
			<ul class="nb-navbar-nav">
				<NavbarLink link="/">Home</NavbarLink>
				<NavbarLink link="/projects">Projects</NavbarLink>
				<NavbarLink link="/contact">Contact</NavbarLink>
			</ul>

			<div class="nb-navbar-actions">
				<button
					class="nb-btn nb-btn-sm size-8 p-0!"
					type="button"
					x-data
					x-on:click="window.toggleTheme()"
				>
					<span
						aria-label="Toggle theme"
						class="icon-[withicons-brutal--moon]"
					></span>
				</button>
				<a
					class="nb-btn nb-btn-sm size-8 p-0!"
					href="https://github.com/IcyTv/portfolio"
					rel="noopener noreferrer"
					target="_blank"
				>
					<span
						aria-label="Go to this website's source code"
						class="icon-[simple-icons--github]"
					></span>
				</a>
			</div>
		</div>
	</nav>

	<slot />
</BaseLayout>
